<Project Sdk="Microsoft.NET.Sdk">
    <PropertyGroup>
        <Product>XIVLauncher.Common.Unix</Product>
        <AssemblyTitle>XIVLauncher.Common.Unix</AssemblyTitle>
        <Description>Shared XIVLauncher platform-specific implementations for Unix-like systems.</Description>
        <VersionPrefix>1.0.0</VersionPrefix>
        <Nullable>disable</Nullable>

        <OutputType>Library</OutputType>
        <TargetFramework>net10.0</TargetFramework>
        <LangVersion>latest</LangVersion>
        <Deterministic>true</Deterministic>
        <ProduceReferenceAssembly>true</ProduceReferenceAssembly>

        <IsOSX Condition="'$(RuntimeIdentifier)' == 'osx-x64'">true</IsOSX>
        <IsLinux Condition="'$(RuntimeIdentifier)' == 'linux-x64' Or '$(RuntimeIdentifier)' == 'linux-arm64'">true</IsLinux>
    </PropertyGroup>

    <PropertyGroup>
        <DefineConstants Condition=" '$(ExtraDefineConstants)' != '' ">
            $(DefineConstants);$(ExtraDefineConstants)</DefineConstants>
    </PropertyGroup>

    <PropertyGroup Condition="'$(RuntimeIdentifier)' == 'linux-arm64' Or '$(XIVLauncherTargetRuntimeIdentifier)' == 'linux-arm64'">
        <DefineConstants>$(DefineConstants);STEAMWORKS_MODERN</DefineConstants>
    </PropertyGroup>

    <ItemGroup>
        <ProjectReference
            Include="..\..\lib\FFXIVQuickLauncher\src\XIVLauncher.Common\XIVLauncher.Common.csproj" />
    </ItemGroup>

    <PropertyGroup Label="Configuration" Condition="'$(Configuration)'=='Release'">
        <AppOutputBase>$(MSBuildProjectDirectory)\</AppOutputBase>
        <PathMap>$(AppOutputBase)=C:\goatsoft\xl\XIVLauncher.Common.Unix\</PathMap>
    </PropertyGroup>

    <ItemGroup>
        <!-- Existing Steamworks implementation for current platforms. -->
        <PackageReference Include="goaaats.Steamworks"
                          Version="2.3.4"
                          Condition="'$(RuntimeIdentifier)' != 'linux-arm64' And '$(XIVLauncherTargetRuntimeIdentifier)' != 'linux-arm64'" />

        <!-- Linux ARM64 requires the newer POSIX bindings for Steamworks SDK 1.64. -->
        <ProjectReference Include="../../lib/Facepunch.Steamworks/Facepunch.Steamworks/Facepunch.Steamworks.Posix.csproj"
                          Condition="'$(RuntimeIdentifier)' == 'linux-arm64' Or '$(XIVLauncherTargetRuntimeIdentifier)' == 'linux-arm64'" />
    </ItemGroup>
</Project>